# aisstream.io API key — register free at https://aisstream.io
AISSTREAM_API_KEY=your_key_here

# Optional: Mapbox token for satellite/nautical basemap
# Leave blank to use CARTO dark tiles (free, no key needed)
MAPBOX_TOKEN=

# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=0

# REQUIRED in production: shared token guarding /admin and all mutating API
# endpoints (sent via the X-Admin-Token header or ?token= query param).
# If unset, those endpoints return 503 (fail closed) — the public read-only
# dashboard keeps working.
ADMIN_TOKEN=

# Optional: path to the bunker prices SQLite DB written by the price scrapers.
# Defaults to the production VPS path /root/bunkervision/bunker_prices.db
#BUNKER_PRICES_DB=/root/bunkervision/bunker_prices.db
